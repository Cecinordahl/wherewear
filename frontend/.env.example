# Firebase client config - from Firebase console > Project settings > General
# > Your apps > SDK setup and configuration. See root README.md for exact steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL. Local dev: http://localhost:8080
# Deployed: your Render service URL, e.g. https://wherewear-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080
